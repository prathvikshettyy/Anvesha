# ShareSpot Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# JWT secret — change this to a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sharespot-dev-secret-change-in-production

# The origin that the Express CORS policy will allow.
# In dev this is the Vite dev server. In prod set to your deployed frontend URL.
CLIENT_ORIGIN=http://localhost:5173

# Node environment — set to "production" in production deployments.
NODE_ENV=development

# ── Client ────────────────────────────────────────────────────────────────────
# The base URL of the API server, used by the React frontend.
VITE_API_URL=http://localhost:3001
